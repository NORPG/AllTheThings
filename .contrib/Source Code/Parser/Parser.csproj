<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <RootNamespace>ATT</RootNamespace>
    <AssemblyName>Parser</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>lib\att_logo_128_new_jrX_icon.ico</ApplicationIcon>
    <StartupObject>ATT.Program</StartupObject>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <FileAlignment>512</FileAlignment>
    <Platforms>x86;x64</Platforms>
    <Platform>x64</Platform>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>..\..\Parser\</OutputPath>
    <DefineConstants>TRACE;RETAIL;TWW</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>..\..\.builds\Parser\x64\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>..\..\.builds\Parser\x86\Release\</OutputPath>
    <DefineConstants>TRACE;RETAIL;TWW</DefineConstants>
    <PlatformTarget>x86</PlatformTarget>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>..\..\.builds\Parser\x86\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <PlatformTarget>x86</PlatformTarget>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <OutputPath>..\..\.builds\Parser\net8.0\$(Platform)\$(Configuration)\</OutputPath>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Csv" Version="2.0.93" />
    <PackageReference Include="KeraLua" Version="1.4.10" />
    <PackageReference Include="NLua" Version="1.7.9" />
  </ItemGroup>
  <Target Name="ValidateParserPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'x86'" Text="Parser supports only the x64 and x86 platforms. Select one in Parser.sln." />
  </Target>
  <UsingTask TaskName="MarkPeLargeAddressAware" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ImagePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var image = new FileStream(ImagePath, FileMode.Open, FileAccess.ReadWrite, FileShare.None))
        using (var reader = new BinaryReader(image))
        {
          var dos = reader.ReadBytes(64);
          if (dos.Length != 64 || dos[0] != 0x4D || dos[1] != 0x5A)
            throw new InvalidDataException("Parser x86 output has no valid DOS header: " + ImagePath);

          int peOffset = BitConverter.ToInt32(dos, 0x3C);
          if (peOffset < 64 || peOffset > image.Length - 24)
            throw new InvalidDataException("Parser x86 output has no valid PE offset: " + ImagePath);

          image.Position = peOffset;
          var pe = reader.ReadBytes(24);
          if (pe.Length != 24 || pe[0] != 0x50 || pe[1] != 0x45 || pe[2] != 0 || pe[3] != 0)
            throw new InvalidDataException("Parser x86 output has no valid PE signature: " + ImagePath);
          if (pe[4] != 0x4C || pe[5] != 0x01)
            throw new InvalidDataException("Parser x86 output is not an x86 PE image: " + ImagePath);

          const byte largeAddressAware = 0x20;
          if ((pe[22] & largeAddressAware) == 0)
          {
            image.Position = peOffset + 22;
            image.WriteByte((byte)(pe[22] | largeAddressAware));
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="MarkParserX86LargeAddressAware" AfterTargets="CoreCompile" Condition="'$(Platform)' == 'x86' and '$(DesignTimeBuild)' != 'true'">
    <MarkPeLargeAddressAware ImagePath="$(IntermediateOutputPath)$(TargetFileName)" />
  </Target>
</Project>
