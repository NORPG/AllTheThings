<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>x64</Platform>
    <Platforms>x64;x86;ARM64;AnyCPU</Platforms>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>lib\att_logo_128_new_jrX_icon.ico</ApplicationIcon>
    <StartupObject>ATT.Program</StartupObject>
    <OutputPath>..\..\.tools\</OutputPath>
    <PlatformTarget>$(Platform)</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <OutputPath>..\..\.tools\x86\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <OutputPath>..\..\.tools\ARM64\</OutputPath>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE;RETAIL;TWW</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <OutputPath>..\..\.tools\AnyCPU\</OutputPath>
    <DefineConstants>$(DefineConstants);PARSER_ANYCPU</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Csv" Version="[2.0.245]" />
    <PackageReference Include="KeraLua" Version="[1.4.11]" GeneratePathProperty="true" />
    <PackageReference Include="NLua" Version="[1.7.9]" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'AnyCPU'">
    <None Include="$(PkgKeraLua)\runtimes\win-x86\native\lua54.dll" Link="x86\lua54.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgKeraLua)\runtimes\win-x64\native\lua54.dll" Link="x64\lua54.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgKeraLua)\runtimes\win-arm64\native\lua54.dll" Link="ARM64\lua54.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateParserPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'x86' and '$(Platform)' != 'ARM64' and '$(Platform)' != 'AnyCPU'" Text="Parser supports only the x64, x86, ARM64, and AnyCPU platforms." />
  </Target>
</Project>
