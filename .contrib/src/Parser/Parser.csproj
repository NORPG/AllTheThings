<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platforms>x86;x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>ATT.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\.tools\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>lib\att_logo_128_new_jrX_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE;RETAIL;TWW</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <OutputPath>..\..\.tools\x86\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Csv" Version="[2.0.245]" />
    <PackageReference Include="KeraLua" Version="[1.4.11]" />
    <PackageReference Include="NLua" Version="[1.7.9]" />
  </ItemGroup>
  <Target Name="ValidateParserPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'x86'" Text="Parser supports only the x64 and x86 platforms." />
  </Target>
</Project>
