<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platforms>x64;x86;MacArm64;MacX64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(Platform)' == 'MacArm64' or '$(Platform)' == 'MacX64'">net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <StartupObject>ATT.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\.tools\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>lib\att_logo_128_new_jrX_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DefineConstants>TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <DebugType>full</DebugType>
    <OutputPath>..\..\.builds\Parser\x64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <DefineConstants>TRACE;RETAIL;TWW</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>..\..\.builds\Parser\x86\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <DefineConstants>TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <DefineConstants>TRACE;RETAIL;TWW</DefineConstants>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <OutputPath>..\..\.builds\Parser\net8.0\$(Platform)\$(Configuration)\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' and '$(Platform)' == 'MacArm64'">
    <OutputPath>..\..\.builds\Parser\net8.0\osx-arm64\$(Configuration)\</OutputPath>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <PlatformTarget>arm64</PlatformTarget>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">TRACE;RETAIL;TWW</DefineConstants>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' and '$(Platform)' == 'MacX64'">
    <OutputPath>..\..\.builds\Parser\net8.0\osx-x64\$(Configuration)\</OutputPath>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">TRACE;DEBUG;RETAIL;TWW</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">TRACE;RETAIL;TWW</DefineConstants>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x86')">
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Csv" Version="[2.0.245]" />
    <PackageReference Include="KeraLua" Version="[1.4.11]" />
    <PackageReference Include="NLua" Version="[1.7.9]" />
  </ItemGroup>
  <Target Name="ValidateParserPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TargetFramework)' == 'net48' and '$(Platform)' != 'x64' and '$(Platform)' != 'x86'" Text="Parser net48 supports only x64 and x86 platforms." />
    <Error Condition="'$(TargetFramework)' == 'net8.0' and '$(Platform)' != 'x64' and '$(Platform)' != 'x86' and '$(Platform)' != 'MacArm64' and '$(Platform)' != 'MacX64'" Text="Parser net8.0 supports x64, x86, MacArm64, and MacX64 platforms." />
  </Target>
  <UsingTask TaskName="MarkPeLargeAddressAware" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ImagePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var image = new FileStream(ImagePath, FileMode.Open, FileAccess.ReadWrite, FileShare.None))
        using (var reader = new BinaryReader(image))
        {
          var dos = reader.ReadBytes(64);
          if (dos.Length != 64 || dos[0] != 0x4D || dos[1] != 0x5A)
            throw new InvalidDataException("Parser x86 output has no valid DOS header: " + ImagePath);

          int peOffset = BitConverter.ToInt32(dos, 0x3C);
          if (peOffset < 64 || peOffset > image.Length - 24)
            throw new InvalidDataException("Parser x86 output has no valid PE offset: " + ImagePath);

          image.Position = peOffset;
          var pe = reader.ReadBytes(24);
          if (pe.Length != 24 || pe[0] != 0x50 || pe[1] != 0x45 || pe[2] != 0 || pe[3] != 0)
            throw new InvalidDataException("Parser x86 output has no valid PE signature: " + ImagePath);
          if (pe[4] != 0x4C || pe[5] != 0x01)
            throw new InvalidDataException("Parser x86 output is not an x86 PE image: " + ImagePath);

          const byte largeAddressAware = 0x20;
          if ((pe[22] & largeAddressAware) == 0)
          {
            image.Position = peOffset + 22;
            image.WriteByte((byte)(pe[22] | largeAddressAware));
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="MarkParserX86LargeAddressAware" AfterTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net48' and '$(Platform)' == 'x86' and '$(DesignTimeBuild)' != 'true'">
    <MarkPeLargeAddressAware ImagePath="$(IntermediateOutputPath)$(TargetFileName)" />
  </Target>
  <Target Name="MarkParserNet8X86AppHostLargeAddressAware" AfterTargets="_CreateAppHost" Condition="'$(TargetFramework)' == 'net8.0' and '$(RuntimeIdentifier)' == 'win-x86' and '$(Platform)' == 'x86' and '$(DesignTimeBuild)' != 'true'">
    <MarkPeLargeAddressAware ImagePath="$(AppHostIntermediatePath)" />
  </Target>
</Project>
