#!/bin/sh

# A locally-created merge commit cannot have a published artifact yet.  Only
# try the best-effort sync when HEAD is already reachable from a remote-tracking
# ref, which is the useful fast-forward/pulled-commit case.
head=$(git rev-parse HEAD 2>/dev/null) || exit 0
if git for-each-ref --contains "$head" --format='%(refname)' refs/remotes |
  grep -q .
then
  "$(dirname "$0")/run-db-sync"
fi

exit 0
