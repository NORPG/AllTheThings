#!/bin/sh

# Git hooks must never make checkout, pull, merge, or rebase fail.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
config=$(git rev-parse --git-path att-script-deploy.json 2>/dev/null) || exit 0
case "$config" in /*) ;; *) config="$root/$config" ;; esac
[ -f "$config" ] || { echo "ATT script deployment: configure and install stable hooks first; skipping." >&2; exit 0; }
echo "ATT script deployment: stable external hooks require install-hooks; skipping." >&2
exit 0
