###############################################################################
# Text normalization
###############################################################################
# Store text as LF and check it out as LF, independent of core.autocrlf.
* text=auto eol=lf

# Windows command scripts use CRLF in the working tree (LF in Git).
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell uses the default LF policy.
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# These formats are binary throughout the repository.
*.blp binary
*.dll binary
*.exe binary
*.ogg binary
*.ico binary
*.pdb binary
*.nupkg binary
*.so binary
*.dylib binary

###############################################################################
# used to remove files from deployment using `git archive`
###############################################################################
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.pkgmeta export-ignore
.pre-commit-config.yaml export-ignore
_config.yml export-ignore
setup.cfg export-ignore
contrib export-ignore
.contrib export-ignore
.github export-ignore
