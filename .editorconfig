root = true

[*]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.lua]
end_of_line = crlf
indent_style = tab

[.config/.exports/**]
trim_trailing_whitespace = false

[.contrib/Harvesters/**]
trim_trailing_whitespace = false

[.contrib/Debugging/**]
trim_trailing_whitespace = false
[/{AllTheThings.lua,lib/**.lua,src/**.lua}]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

[/{tests,locales}/*.lua]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Binary assets (BLP, OGG, WAV)
[assets/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

# Binary asset extensions (BLP, OGG, WAV)
[**.{blp,ogg,wav}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
