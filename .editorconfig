root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.lua]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[.config/.exports/**]
trim_trailing_whitespace = false

[.contrib/Harvesters/**]
trim_trailing_whitespace = false

[.contrib/Debugging/**]
trim_trailing_whitespace = false

# Raw Wago CSV fields include meaningful spaces in multiline localized text.
[.contrib/.db/standard/.config/.wago/**.csv]
trim_trailing_whitespace = false
